# Demo form email delivery (optional; without these the form still works
# and logs leads to the server console). Set both in Vercel project env.
RESEND_API_KEY=
DEMO_TO_EMAIL=contact@fluidly.ai

# Sanity blog CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=cmaa3p5c
NEXT_PUBLIC_SANITY_DATASET=production
# server-only: read token (Sanity manage -> API -> Tokens, Viewer role)
SANITY_API_READ_TOKEN=
# server-only: shared secret for the publish webhook -> on-demand revalidate
SANITY_REVALIDATE_SECRET=
